root = true

[*]
charset             = utf-8
end_of_line         = lf
indent_style        = space
indent_size         = 4
trim_trailing_whitespace = true
insert_final_newline = true

[*.toml]
indent_size = 2

[*.yml]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# cargo-dist generates this file — do not reformat it
[.github/workflows/release.yml]
indent_style = unset
indent_size  = unset
trim_trailing_whitespace = unset
insert_final_newline     = unset
